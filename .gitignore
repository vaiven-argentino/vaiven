# Material con derechos de autor: nunca se sube (repositorio público)
capturas/
_versiones/

# Node y Wrangler
node_modules/
.wrangler/
.dev.vars*
!.dev.vars.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Sistema y editores
.DS_Store
.idea/
.vscode/
*.log

# Pipeline: crudos de fuentes no redistribuibles (solo se versiona su meta.json)
.crudos/

# Descargas completas: se generan al publicar (no se versionan)
export/descargas/*.zip
export/descargas/*.parquet

# Web: copias del export y archivos generados antes de cada build
web/public/datos/
web/public/esquemas/
web/public/_redirects
web/dist/
web/.astro/

# MCP: la variante local empaquetada (npm run empaquetar -w @vaiven/mcp)
mcp/dist/
