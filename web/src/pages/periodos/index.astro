---
// Períodos (SPEC 6.1): línea de tiempo de gobiernos, ministros de Economía, planes, regímenes cambiarios, etapas de la
// política económica y episodios, con los eventos; debajo, una tabla compacta por tipo en la que cada fila se despliega
// (descripción, notas, mandatos o fases, fuentes con su confianza y accesos al explorador). Página estática: se lee sin
// JavaScript; un script mínimo abre la fila a la que lleva un enlace (#id).
import Base from "../../layouts/Base.astro";
import { citaRegistro } from "@vaiven/cita";
import { periodosDe, rangoLegible, type FuentePeriodo, type Periodo, type TipoPeriodo } from "@vaiven/transformaciones";
import { catalogo, eventos as leerEventos, periodos as leerPeriodos, tamano } from "../../lib/export";
import { accesoEvento, accesosDe, avisoConfianza, lineaDeTiempo } from "../../lib/periodos";

const registro = leerPeriodos();
const registroEventos = leerEventos();
if (!registro || !registroEventos) throw new Error("Faltan export/periodos.json o export/eventos.json: corré el pipeline.");
const hoy = new Date().toISOString().slice(0, 10);
const anioHoy = Number(hoy.slice(0, 4));
const publicadas = new Set(catalogo().series.filter((s) => s.variantes.some((v) => v.estado === "publicada")).map((s) => s.id));

// Línea de tiempo: 1970 a fin del año en curso, en un lienzo de 1160 px que ocupa el ancho de la página y en el celular
// se desplaza de costado (nunca baja de 1100 px, para que los rótulos se lean).
const INICIO = 1970, FIN = anioHoy + 1, ANCHO = 1000, MARGEN = 150, ALTO_FILA = 24, SEP = 10;
const NOMBRE_CARRIL: Record<string, string> = { catedra: "Etapas (curso)", gobierno: "Gobiernos", ministro: "Ministros", plan: "Planes", regimen_cambiario: "Regímenes cambiarios", episodio: "Episodios", evento: "Eventos" };
const carriles = lineaDeTiempo(registro, registroEventos, ANCHO, INICIO, FIN, hoy);
let y = 30;
const ubicados = carriles.map((c) => { const salida = { ...c, y }; y += c.filas * ALTO_FILA + SEP; return salida; });
const altoSvg = y + 6;
const anios = Array.from({ length: Math.floor((FIN - INICIO) / 5) + 1 }, (_, k) => INICIO + k * 5);
const xAnio = (a: number) => MARGEN + ((a - INICIO) / (FIN - INICIO)) * ANCHO;

const ORDEN: TipoPeriodo[] = ["catedra", "gobierno", "ministro", "plan", "regimen_cambiario", "episodio"];
const NIVEL: Record<string, string> = { alta: "alta", media: "media (una sola fuente o sin verificación independiente)", baja: "baja (las fuentes no coinciden)" };
const textoConfianzaLargo = (c?: { desde: string; hasta?: string }) =>
  c ? `Confianza de las fechas: inicio, ${NIVEL[c.desde]}${c.hasta ? `; fin, ${NIVEL[c.hasta]}` : ""}.` : "";
const nombreTipo = new Map(registro.tipos.map((t) => [t.id, t.nombre]));
const ancla = (id: string) => id;
const fuenteTexto = (f: FuentePeriodo) => `${f.referencia ?? f.nota ?? ""}${f.pagina !== undefined ? `, p. ${f.pagina}` : ""}${f.publicado ? ` (publicado ${f.publicado})` : ""}`;
const PARA: Record<string, string> = { desde: "Inicio", hasta: "Fin", ambas: "Inicio y fin" };
const CARACTER: Record<string, string> = { constitucional: "Constitucional", de_facto: "De facto", interino: "Interino" };
const CATEGORIA = new Map(registroEventos.categorias.map((c) => [c.id, c.nombre]));
const fechaLarga = (d: string) => { const [a, m, dd] = d.split("-"); return `${Number(dd)}/${Number(m)}/${a}`; };
const cita = citaRegistro("periodos", registro.version_datos);
const tamanos = { pj: tamano("periodos.json"), ej: tamano("eventos.json"), pc: tamano("descargas/csv/periodos.csv"), ec: tamano("descargas/csv/eventos.csv") };
const lista = (tipo: TipoPeriodo): Periodo[] => periodosDe(registro, tipo);
// La columna «carácter o cargo»: en los gobiernos, el carácter; en los ministros, la primera parte del cargo (el texto
// completo va en el detalle). Los demás tipos no la llevan.
const COLUMNA_EXTRA: Partial<Record<TipoPeriodo, string>> = { gobierno: "Carácter", ministro: "Cargo" };
const extra = (p: Periodo) => (p.caracter ? CARACTER[p.caracter] : p.cargo ? p.cargo.split("; ")[0].replace(/[«»]/g, "") : "");
---
<Base titulo="Períodos" descripcion="Gobiernos, ministros de Economía, planes de estabilización, regímenes cambiarios y etapas de la política económica argentina desde 1970, con fechas, fuentes y accesos a gráficos ya filtrados." seccion="periodos">
  <article class="periodos contenedor">
    <header class="cabeza">
      <h1>Períodos de la política económica, 1970–hoy</h1>
      <p class="lectura">Gobiernos, ministros de Economía, planes de estabilización, regímenes cambiarios y etapas de la política económica, con la fuente de cada fecha. Desde cada período podés abrir gráficos ya filtrados en el explorador.</p>
      <p class="lectura secundario">Los períodos van del día de inicio al día en que empieza el siguiente: el día del traspaso es del que entra. Cuando un fin no es un hecho fechado (sobre todo en los planes), lo dice: es un corte convencional de Vaivén.</p>
      <nav aria-label="Tipos de período" class="indice">
        <ul>
          {ORDEN.map((t) => <li><a href={`#${t}`}>{nombreTipo.get(t)}</a></li>)}
          <li><a href="#eventos">Eventos</a></li>
          <li><a href="#citar">Cómo citar y descargar</a></li>
        </ul>
      </nav>
    </header>

    <section aria-labelledby="titulo-linea" class="linea">
      <h2 id="titulo-linea">Línea de tiempo</h2>
      <p class="secundario">Cada tramo lleva a su fila en las tablas de abajo. En pantallas chicas, desplazá la línea de costado.</p>
      <div class="linea-marco" tabindex="0" role="region" aria-label="Línea de tiempo (con desplazamiento)">
        <svg viewBox={`0 0 ${MARGEN + ANCHO + 12} ${altoSvg}`} role="group" aria-labelledby="titulo-linea" aria-describedby="desc-linea">
          <desc id="desc-linea">Línea de tiempo de {INICIO} a {anioHoy} con un carril por tipo de período y uno de eventos. El detalle de cada período está en las listas de abajo.</desc>
          {anios.map((a) => (
            <g class="anio">
              <line x1={xAnio(a)} x2={xAnio(a)} y1={22} y2={altoSvg - 4} />
              <text x={xAnio(a)} y={14} text-anchor="middle">{a}</text>
            </g>
          ))}
          {ubicados.map((c) => (
            <g class="carril">
              <text class="nombre-carril" x={MARGEN - 10} y={c.y + (c.filas * ALTO_FILA) / 2 + 4} text-anchor="end">{NOMBRE_CARRIL[c.tipo] ?? c.nombre}</text>
              {c.tipo === "evento"
                ? c.tramos.map((t) => (
                  <a href={`#${ancla(t.id)}`}>
                    <title>{t.nombre} ({t.rango})</title>
                    <line class="evento" x1={MARGEN + t.x} x2={MARGEN + t.x} y1={c.y + 2} y2={c.y + ALTO_FILA - 4} />
                  </a>
                ))
                : c.tramos.map((t) => (
                  <a href={`#${ancla(t.id)}`}>
                    <title>{t.nombre} ({t.rango})</title>
                    <rect class={`tramo ${t.clase}`} x={MARGEN + t.x} y={c.y + t.fila * ALTO_FILA} width={t.ancho} height={ALTO_FILA - 4} />
                    {t.rotulo && <text class="rotulo" x={MARGEN + t.x + 4} y={c.y + t.fila * ALTO_FILA + 14}>{t.corto}</text>}
                  </a>
                ))}
            </g>
          ))}
        </svg>
      </div>
    </section>

    <p class="lectura secundario leyenda-marcas">En las tablas, cada fila se despliega con la descripción, las notas, las fuentes (con la confianza de cada fecha) y accesos al explorador. Marcas: <span class="marca">◇</span> el fin es un corte convencional de Vaivén, no un hecho fechado; <span class="marca">⚠</span> fecha a confirmar (las fuentes no coinciden).</p>

    {ORDEN.map((tipo) => (
      <section aria-labelledby={tipo} class="tipo">
        <h2 id={tipo}>{nombreTipo.get(tipo)} <span class="secundario cantidad">({lista(tipo).length})</span></h2>
        {tipo === "catedra" && <p class="lectura secundario">Periodización de un curso universitario de política económica argentina. Los nombres son los del curso; las fechas de corte las fijó Vaivén a partir de hechos fechados, con su fuente.</p>}
        {tipo === "ministro" && <p class="lectura secundario">Titular de la cartera de Hacienda o Economía según la estructura de cada época (en 1971–1973, Hacienda y Finanzas; en 2017–2019, Hacienda), y los interinos designados por decreto durante una vacante. Puede haber días sin titular entre una renuncia y la jura del siguiente.</p>}
        {tipo === "episodio" && <p class="lectura secundario">Procesos de varios meses que la historiografía trata como una unidad (por ejemplo, una hiperinflación). Pueden superponerse con otros y tener fases. En los gráficos se marcan con «Marcar eventos», en una franja debajo del eje.</p>}
        {tipo === "regimen_cambiario" && <p class="lectura secundario">Un tramo nuevo empieza cuando se crea o se elimina un mercado de cambios o cambia la forma de fijar el tipo de cambio; una devaluación dentro del mismo esquema no abre un tramo.</p>}
        <div class={`tabla${COLUMNA_EXTRA[tipo] ? " con-extra" : ""}`}>
          <div class="grilla encabezados" aria-hidden="true">
            <span>Nombre</span><span>Desde</span><span>Hasta</span>{COLUMNA_EXTRA[tipo] && <span>{COLUMNA_EXTRA[tipo]}</span>}<span>Marcas</span>
          </div>
          <ol class="filas">
            {lista(tipo).map((p) => (
              <li class="fila" id={ancla(p.id)}>
                <details>
                  <summary class="grilla">
                    <span class="c-nombre"><span class="largo">{p.nombre}</span><span class="corto">{p.nombre_corto}</span></span>
                    <span class="c-desde"><span class="visualmente-oculto">desde el </span>{fechaLarga(p.desde)}</span>
                    <span class="c-hasta"><span class="visualmente-oculto">hasta el </span>{p.hasta ? fechaLarga(p.hasta) : "vigente"}</span>
                    {COLUMNA_EXTRA[tipo] && <span class="c-extra">{extra(p)}</span>}
                    <span class="c-marcas">
                      {p.cortes.hasta === "convencional" && <span class="marca" title="El fin es un corte convencional de Vaivén">◇<span class="visualmente-oculto"> fin convencional</span></span>}
                      {avisoConfianza(p) && <span class="marca" title={avisoConfianza(p)}>⚠<span class="visualmente-oculto"> {avisoConfianza(p)}</span></span>}
                    </span>
                  </summary>
                  <div class="detalle">
                    <p class="solo-celular"><strong>{p.nombre}</strong>{p.caracter && <> · {CARACTER[p.caracter]}</>}</p>
                    {p.cargo && <p class="secundario">Cargo: {p.cargo}</p>}
                    {avisoConfianza(p) && <p class="a-confirmar">⚠ {avisoConfianza(p).replace(/^./, (c) => c.toUpperCase())}: las fuentes no coinciden.</p>}
                    {p.cortes.hasta === "convencional" && <p class="convencional">◇ El fin es un corte convencional de Vaivén, no un hecho fechado.</p>}
                    {p.descripcion && <p>{p.descripcion}</p>}
                    {p.notas && <p class="secundario">{p.notas}</p>}
                    {p.mandatos && (
                      <ul class="mandatos" aria-label="Mandatos">
                        {p.mandatos.map((m) => <li id={ancla(m.id)}>{m.nombre}: {rangoLegible(m)}</li>)}
                      </ul>
                    )}
                    {p.fases && (
                      <ul class="mandatos" aria-label="Fases">
                        {p.fases.map((f) => <li id={ancla(f.id)}>{f.nombre}: {rangoLegible(f)}{f.descripcion && <> · <span class="secundario">{f.descripcion}</span></>}</li>)}
                      </ul>
                    )}
                    <div class="fuentes">
                      <h3 class="etiqueta">Fuentes</h3>
                      {p.confianza && <p class="secundario">{textoConfianzaLargo(p.confianza)}</p>}
                      <ul>
                        {p.fuentes.map((f) => (
                          <li><span class="secundario">{PARA[f.para ?? "ambas"]}:</span> {f.url ? <a href={f.url} rel="noopener">{fuenteTexto(f)}</a> : fuenteTexto(f)}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="accesos">
                      <h3 class="etiqueta">Ver en el explorador</h3>
                      <ul>{accesosDe(p, publicadas, anioHoy).map((a) => <li><a href={a.url}>{a.texto}</a></li>)}</ul>
                    </div>
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ))}

    <section aria-labelledby="eventos" class="tipo">
      <h2 id="eventos">Eventos <span class="secundario cantidad">({registroEventos.eventos.length})</span></h2>
      <p class="lectura secundario">Hechos económicos o institucionales con efecto económico. La fecha es la del hecho que nombran (anuncio, sanción, firma); la vigencia, si es otra, va aparte.</p>
      <div class="tabla con-extra">
        <div class="grilla encabezados" aria-hidden="true">
          <span>Nombre</span><span>Fecha</span><span>Vigente desde</span><span>Categoría</span><span></span>
        </div>
        <ol class="filas">
          {registroEventos.eventos.map((e) => (
            <li class="fila" id={ancla(e.id)}>
              <details>
                <summary class="grilla">
                  <span class="c-nombre"><span class="largo">{e.nombre}</span><span class="corto">{e.nombre_corto}</span></span>
                  <span class="c-desde">{fechaLarga(e.fecha)}</span>
                  <span class="c-hasta">{e.vigencia ? <><span class="visualmente-oculto">vigente desde el </span>{fechaLarga(e.vigencia)}</> : ""}</span>
                  <span class="c-extra">{CATEGORIA.get(e.categoria) ?? e.categoria}</span>
                  <span class="c-marcas"></span>
                </summary>
                <div class="detalle">
                  <p class="solo-celular"><strong>{e.nombre}</strong> · {CATEGORIA.get(e.categoria) ?? e.categoria}</p>
                  <p>{e.descripcion}</p>
                  {e.notas && <p class="secundario">{e.notas}</p>}
                  <div class="fuentes">
                    <h3 class="etiqueta">Fuentes</h3>
                    <ul>{e.fuentes.map((f) => <li>{f.url ? <a href={f.url} rel="noopener">{fuenteTexto(f)}</a> : fuenteTexto(f)}</li>)}</ul>
                  </div>
                  <div class="accesos">
                    <h3 class="etiqueta">Ver en el explorador</h3>
                    <ul><li><a href={accesoEvento(e.fecha, anioHoy).url}>{accesoEvento(e.fecha, anioHoy).texto}</a></li></ul>
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section aria-labelledby="citar" class="tipo">
      <h2 id="citar">Cómo citar y descargar</h2>
      <pre class="texto-cita" tabindex="0">{cita}</pre>
      <ul class="lista-descargas">
        <li><a href="/datos/periodos.json" download>periodos.json</a> <span class="secundario">{tamanos.pj} · con las fuentes de cada fecha</span></li>
        <li><a href="/datos/descargas/csv/periodos.csv" download>periodos.csv</a> <span class="secundario">{tamanos.pc} · una fila por período o mandato</span></li>
        <li><a href="/datos/eventos.json" download>eventos.json</a> <span class="secundario">{tamanos.ej}</span></li>
        <li><a href="/datos/descargas/csv/eventos.csv" download>eventos.csv</a> <span class="secundario">{tamanos.ec}</span></li>
      </ul>
      <p class="secundario">Versión de los períodos: {fechaLarga(registro.version_datos.slice(0, 10))}. Licencia CC BY 4.0. Los agentes de IA pueden consultarlos con las herramientas <code>listar_periodos</code> y <code>periodo_en_fecha</code> del <a href="/agentes/">MCP</a>.</p>
    </section>
  </article>
  <script is:inline>
    // Al llegar con #id (desde la línea de tiempo u otro enlace), abre la fila (o la que contiene el mandato o la fase).
    (function () {
      function abrir() {
        var id = decodeURIComponent(location.hash.slice(1));
        var el = id && document.getElementById(id);
        if (!el) return;
        var d = el.matches("li.fila") ? el.querySelector("details") : el.closest("details");
        if (d && !d.open) { d.open = true; el.scrollIntoView({ block: "start" }); }
      }
      abrir();
      window.addEventListener("hashchange", abrir);
    })();
  </script>
</Base>

<style>
  .periodos { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; }
  .cabeza { display: grid; gap: 10px; }
  .lectura { max-width: 72ch; }
  .indice ul { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .indice a { display: inline-block; padding: 10px 0; }
  .linea { display: grid; gap: 8px; min-width: 0; }
  .linea-marco { overflow-x: auto; border: 1px solid var(--linea); border-radius: var(--radio); background: var(--fondo); }
  .linea-marco svg { display: block; font-family: var(--sans); width: 100%; min-width: 1100px; max-width: none; height: auto; }
  .anio line { stroke: var(--linea); stroke-width: 1; }
  .anio text, .nombre-carril { fill: var(--secundario); font-size: 12px; }
  .nombre-carril { font-weight: 600; fill: var(--texto); }
  .tramo { stroke: var(--borde); stroke-width: 0.5; }
  .tramo.a { fill: var(--periodo-a); }
  .tramo.b { fill: var(--periodo-b); }
  .tramo.facto { fill: var(--periodo-facto); }
  a:hover .tramo, a:focus .tramo { stroke: var(--acento); stroke-width: 2; }
  .rotulo { fill: var(--texto); font-size: 11px; pointer-events: none; }
  .evento { stroke: var(--texto); stroke-width: 2; }
  a:hover .evento, a:focus .evento { stroke: var(--acento); stroke-width: 3; }
  .tramo.franja { fill: var(--periodo-franja); }
  .tipo { display: grid; gap: 12px; min-width: 0; }
  .cantidad { font-weight: 400; font-size: 1rem; }
  .leyenda-marcas .marca { color: var(--texto); font-weight: 600; }
  /* Tabla compacta por tipo: cada fila es un <details> cuyo <summary> lleva las columnas. En el celular, el nombre en una
     línea y las fechas, el carácter o cargo y las marcas en la siguiente (revisión externa de la 4b, 9.4). */
  .tabla { border-top: 1px solid var(--linea); min-width: 0; }
  .filas { list-style: none; margin: 0; padding: 0; }
  .fila { border-bottom: 1px solid var(--linea); scroll-margin-top: 16px; min-width: 0; }
  .grilla { display: grid; grid-template-columns: minmax(0, 1fr); align-items: baseline; gap: 0 10px; padding: 6px 4px 6px 22px; position: relative; }
  .encabezados { display: none; }
  summary.grilla { cursor: pointer; min-height: 44px; list-style: none; }
  summary.grilla::-webkit-details-marker { display: none; }
  summary.grilla::before { content: "▸"; position: absolute; left: 4px; top: 50%; transform: translateY(-50%); color: var(--secundario); transition: transform 0.15s; }
  details[open] > summary.grilla::before { transform: translateY(-50%) rotate(90deg); }
  summary.grilla:hover .c-nombre { color: var(--acento); }
  .c-nombre { font-weight: 600; overflow-wrap: anywhere; }
  .c-desde, .c-hasta, .c-extra, .c-marcas { font-size: 0.88rem; color: var(--secundario); font-variant-numeric: tabular-nums; }
  /* En el celular, una fila por línea: el nombre corto, las fechas y las marcas; el nombre completo y el carácter o cargo,
     en el detalle. */
  @media (max-width: 699px) {
    summary.grilla { display: flex; align-items: center; gap: 8px; padding-top: 0; padding-bottom: 0; }
    .c-nombre { flex: 1 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .c-nombre .largo, .c-extra { display: none; }
    .c-desde, .c-hasta { white-space: nowrap; flex: none; }
    .c-hasta:not(:empty)::before { content: "– "; }
    .c-desde:has(+ .c-hasta:not(:empty)) { margin-right: -6px; }
    .c-marcas { flex: none; }
  }
  @media (min-width: 700px) {
    .encabezados { display: grid; font-size: 0.8rem; font-weight: 600; color: var(--secundario); padding-top: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--linea); }
    .grilla { grid-template-columns: minmax(0, 1fr) 6.5rem 6.5rem 3.5rem; }
    .con-extra .grilla { grid-template-columns: minmax(0, 1.6fr) 6.5rem 6.5rem minmax(0, 1fr) 3.5rem; }
    summary.grilla { align-items: center; }
    .c-extra { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .c-nombre .corto, .solo-celular { display: none; }
  }
  .c-marcas { color: var(--texto); font-weight: 600; letter-spacing: 0.1em; }
  .fila:target > details > summary, .mandatos li:target { background: var(--superficie); box-shadow: inset 3px 0 0 var(--acento); }
  .detalle { display: grid; gap: 8px; padding: 2px 4px 14px 22px; max-width: 80ch; }
  .detalle p { margin: 0; }
  .convencional { font-size: 0.88rem; color: var(--ocre); }
  .a-confirmar { font-size: 0.88rem; font-weight: 600; margin: 0; }
  .mandatos { margin: 0; padding-left: 1.1em; font-size: 0.9rem; }
  .mandatos li { scroll-margin-top: 16px; }
  .fuentes, .accesos { display: grid; gap: 4px; }
  .fuentes ul { margin: 0; padding-left: 1.1em; display: grid; gap: 4px; font-size: 0.85rem; overflow-wrap: anywhere; }
  /* Los accesos, como lista de enlaces con 44 px de alto de toque. */
  .accesos ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 18px; font-size: 0.9rem; }
  .accesos a { display: inline-flex; align-items: center; min-height: 44px; }
