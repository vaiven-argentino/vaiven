# Encabezados de los static assets del Worker (Cloudflare lee este archivo de web/dist).
/datos/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/esquemas/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# El script de la interfaz del gráfico en Claude (ui://vaiven/grafico, SPEC 7.4): se pide desde el iframe del host, de
# otro origen, como módulo (por eso el CORS). El nombre lleva el hash del contenido, así que la caché puede ser larga.
/mcp-app/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
