{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vaiven",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": false,
  // Disparo diario del pipeline (SPEC 5.1): 21:23 UTC = 18:23 en Argentina, después de las publicaciones del INDEC.
  // El token va como secreto: `npx wrangler secret put GITHUB_TOKEN_DISPARO`.
  "triggers": { "crons": ["23 21 * * *"] },
  "assets": {
    // El build de Astro (npm run build -w @vaiven/web). Incluye el export en /datos/ y los esquemas en /esquemas/.
    "directory": "../web/dist",
    "binding": "ASSETS",
    // Solo estas rutas pasan por el código; el resto se sirve como archivo estático (sin costo de CPU).
    "run_worker_first": ["/salud"],
    // Las rutas que no existen devuelven web/dist/404.html con estado 404.
    "not_found_handling": "404-page"
  }
}
