{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vaiven",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // En la fase 2 pasa a ser el build de Astro (../web/dist).
    "directory": "./public",
    "binding": "ASSETS",
    // Solo estas rutas pasan por el código; el resto se sirve como archivo estático (sin costo de CPU).
    "run_worker_first": ["/salud"]
  }
}
