{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts", "./secretos.d.ts"]
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts", "secretos.d.ts"]
}
