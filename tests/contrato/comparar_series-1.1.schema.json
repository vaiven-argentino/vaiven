{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaiven.argentino.workers.dev/esquemas/comparar_series-1.1.json",
  "title": "Respuesta de comparar_series (MCP de Vaivén), versión 1.1",
  "description": "SPEC 7.2. Con alinear = frecuencia_comun: frecuencia, columnas y datos como filas [fecha, v1, v2…]. Con alinear = ninguna: los datos de cada serie dentro de series. Va igual en el texto y en structuredContent. Regla de versión de la sección 2.5. La 1.1 (menor) suma el aviso c.agregaciones-distintas; la 1.0 sigue publicada.",
  "type": "object",
  "required": [
    "alinear",
    "series",
    "advertencias_combinacion",
    "n_observaciones",
    "version_datos"
  ],
  "additionalProperties": false,
  "properties": {
    "alinear": {
      "enum": [
        "frecuencia_comun",
        "ninguna"
      ]
    },
    "frecuencia": {
      "enum": [
        "mensual",
        "trimestral",
        "anual"
      ]
    },
    "columnas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "serie",
          "id",
          "unidad"
        ],
        "additionalProperties": false,
        "properties": {
          "serie": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "id": {
            "type": "string"
          },
          "pais": {
            "type": "string"
          },
          "unidad": {
            "type": "string"
          },
          "notas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "datos": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$"
          }
        ],
        "items": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/serie"
      }
    },
    "advertencias_combinacion": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aviso"
      }
    },
    "n_observaciones": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "version_datos": {
      "type": "string"
    },
    "notas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "alinear": {
            "const": "frecuencia_comun"
          }
        }
      },
      "then": {
        "required": [
          "frecuencia",
          "columnas",
          "datos"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "alinear": {
            "const": "ninguna"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "datos"
          ]
        }
      }
    }
  ],
  "$defs": {
    "aviso": {
      "type": "object",
      "required": [
        "id",
        "descripcion"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "c.frecuencia-comun",
            "c.sin-datos",
            "c.ejes-ignorado",
            "c.log-distinto",
            "c.variacion-promedio",
            "c.sin-equivalente",
            "c.agregaciones-distintas"
          ]
        },
        "descripcion": {
          "type": "string"
        },
        "series": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    },
    "advertencia": {
      "type": "object",
      "required": [
        "id",
        "tipo",
        "descripcion"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "desde": {
          "type": [
            "string",
            "null"
          ]
        },
        "hasta": {
          "type": [
            "string",
            "null"
          ]
        },
        "tipo": {
          "type": "string"
        },
        "descripcion": {
          "type": "string"
        },
        "entidades": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "serie": {
      "type": "object",
      "required": [
        "numero",
        "id",
        "serie",
        "variante",
        "nombre",
        "unidad",
        "transformacion",
        "ultimo_dato",
        "atraso",
        "advertencias",
        "excluidos",
        "notas",
        "fuentes",
        "licencia",
        "version_datos",
        "cita"
      ],
      "properties": {
        "numero": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "id": {
          "type": "string"
        },
        "serie": {
          "type": "string"
        },
        "variante": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "nombre_variante": {
          "type": "string"
        },
        "unidad": {
          "type": "string"
        },
        "transformacion": {
          "type": "string"
        },
        "paises": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "nombre"
            ]
          }
        },
        "ultimo_dato": {
          "type": "string"
        },
        "atraso": {
          "type": [
            "object",
            "null"
          ]
        },
        "advertencias": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/advertencia"
          }
        },
        "excluidos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fecha",
              "motivo"
            ]
          }
        },
        "notas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fuentes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "organismo",
              "licencia"
            ]
          }
        },
        "licencia": {
          "type": "string"
        },
        "version_datos": {
          "type": "string"
        },
        "desactualizada_desde": {
          "type": [
            "string",
            "null"
          ]
        },
        "cita": {
          "type": "string"
        },
        "datos": {},
        "frecuencias": {
          "type": "array"
        }
      }
    }
  }
}
