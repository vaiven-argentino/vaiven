{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaiven.argentino.workers.dev/esquemas/especificacion_grafico-1.2.json",
  "title": "Respuesta de especificacion_grafico (MCP de Vaivén), versión 1.1",
  "description": "SPEC 7.2 y 7.4. La especificación de Vega-Lite de la vista, con los datos incluidos y el mismo armado que el explorador; url_explorador con esa vista; la disposición, las advertencias y las citas. La especificación va solo en structuredContent; el texto lleva lo demás (SPEC 7.2). Regla de versión de la sección 2.5. La 1.1 (menor) sumó el aviso c.agregaciones-distintas; la 1.2 (menor), en la 4e: el aviso c.escalas-distintas, la escala de cada panel, los quiebres numerados (con su id, corridos), los avisos c.doble-eje y c.pico, los datos excluidos de cada serie, su nombre corto, su color y su trazo, los episodios y el nombre del archivo; acepta además los parámetros tema, imagen y leyenda, que no cambian la forma. Las anteriores siguen publicadas.",
  "type": "object",
  "required": [
    "especificacion",
    "url_explorador",
    "disposicion",
    "series",
    "advertencias_combinacion",
    "quiebres",
    "nombre_archivo",
    "n_observaciones",
    "version_datos"
  ],
  "additionalProperties": false,
  "properties": {
    "especificacion": {
      "type": "object",
      "required": [
        "$schema"
      ],
      "properties": {
        "$schema": {
          "const": "https://vega.github.io/schema/vega-lite/v6.json"
        }
      },
      "anyOf": [
        {
          "required": [
            "layer"
          ]
        },
        {
          "required": [
            "vconcat"
          ]
        },
        {
          "required": [
            "mark"
          ]
        }
      ]
    },
    "url_explorador": {
      "type": "string",
      "pattern": "^https://vaiven\\.argentino\\.workers\\.dev/explorador/(\\?.*)?$"
    },
    "disposicion": {
      "type": "object",
      "required": [
        "tipo",
        "paneles"
      ],
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "enum": [
            "unico",
            "doble_eje",
            "paneles"
          ]
        },
        "paneles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "unidad",
              "series",
              "escala"
            ],
            "additionalProperties": false,
            "properties": {
              "unidad": {
                "type": "string"
              },
              "series": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                }
              },
              "escala": {
                "enum": [
                  "lineal",
                  "log"
                ],
                "description": "La escala que se dibuja en el panel (la logarítmica pedida, solo si todos los valores son positivos)."
              }
            }
          }
        }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "numero",
          "id",
          "nombre",
          "unidad",
          "transformacion",
          "ultimo_dato",
          "advertencias",
          "notas",
          "cita",
          "nombre_corto",
          "color",
          "trazo"
        ],
        "additionalProperties": false,
        "properties": {
          "numero": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "nombre_corto": {
            "type": "string",
            "description": "El nombre de la serie en el gráfico (etiquetas, leyenda, títulos de los ejes)."
          },
          "nombre_variante": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "El color de su línea (en la internacional, el secundario)."
          },
          "trazo": {
            "enum": [
              "continuo",
              "discontinuo"
            ],
            "description": "Discontinuo: otra variante de una serie que ya está en el gráfico."
          },
          "unidad": {
            "type": "string"
          },
          "transformacion": {
            "type": "string"
          },
          "paises": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "nombre"
              ]
            }
          },
          "ultimo_dato": {
            "type": "string"
          },
          "advertencias": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "tipo",
                "descripcion"
              ]
            }
          },
          "excluidos": {
            "type": "array",
            "description": "Los datos excluidos que se ven (la «×» del gráfico), con su motivo.",
            "items": {
              "type": "object",
              "required": [
                "fecha",
                "motivo"
              ],
              "additionalProperties": false,
              "properties": {
                "fecha": {
                  "type": "string"
                },
                "motivo": {
                  "type": "string"
                },
                "pais": {
                  "type": "string"
                }
              }
            }
          },
          "notas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cita": {
            "type": "string"
          }
        }
      }
    },
    "advertencias_combinacion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "descripcion"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "c.frecuencia-comun",
              "c.sin-datos",
              "c.ejes-ignorado",
              "c.log-distinto",
              "c.variacion-promedio",
              "c.sin-equivalente",
              "c.agregaciones-distintas",
              "c.escalas-distintas",
              "c.doble-eje",
              "c.pico"
            ]
          },
          "descripcion": {
            "type": "string"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          }
        }
      }
    },
    "sombreado": {
      "type": "object",
      "required": [
        "tipo",
        "periodos"
      ],
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "enum": [
            "catedra",
            "gobierno",
            "mandato",
            "ministro",
            "plan",
            "regimen_cambiario"
          ]
        },
        "periodos": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "eventos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "letra",
          "fecha",
          "nombre"
        ],
        "additionalProperties": false,
        "properties": {
          "letra": {
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "nombre": {
            "type": "string"
          }
        }
      }
    },
    "episodios": {
      "type": "array",
      "description": "Los episodios marcados debajo del eje (con eventos: true o la categoría episodio).",
      "items": {
        "type": "object",
        "required": [
          "nombre",
          "desde",
          "hasta"
        ],
        "additionalProperties": false,
        "properties": {
          "nombre": {
            "type": "string"
          },
          "desde": {
            "type": "string"
          },
          "hasta": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "quiebres": {
      "type": "array",
      "description": "Los quiebres marcados en el gráfico con su número (①②③), numerados corrido: solo los que se dibujan. Las advertencias generales van en series[].advertencias, sin número.",
      "items": {
        "type": "object",
        "required": [
          "numero",
          "serie",
          "id",
          "tipo",
          "desde",
          "hasta",
          "descripcion"
        ],
        "additionalProperties": false,
        "properties": {
          "numero": {
            "type": "integer",
            "minimum": 1
          },
          "serie": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "id": {
            "type": "string",
            "pattern": "^q\\."
          },
          "tipo": {
            "type": "string"
          },
          "desde": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasta": {
            "type": [
              "string",
              "null"
            ]
          },
          "descripcion": {
            "type": "string"
          }
        }
      }
    },
    "nombre_archivo": {
      "type": "string",
      "pattern": "^vaiven_[\\w.-]+$",
      "description": "El nombre de la imagen y de las descargas, sin extensión, como en el explorador."
    },
    "n_observaciones": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "version_datos": {
      "type": "string"
    }
  }
}
