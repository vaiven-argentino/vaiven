{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaiven.argentino.workers.dev/esquemas/especificacion_grafico-1.0.json",
  "title": "Respuesta de especificacion_grafico (MCP de Vaivén), versión 1.0",
  "description": "SPEC 7.2 y 7.4. La especificación de Vega-Lite de la vista, con los datos incluidos y el mismo armado que el explorador; url_explorador con esa vista; la disposición, las advertencias y las citas. Va igual en el texto y en structuredContent. Regla de versión de la sección 2.5.",
  "type": "object",
  "required": ["especificacion", "url_explorador", "disposicion", "series", "advertencias_combinacion", "n_observaciones", "version_datos"],
  "additionalProperties": false,
  "properties": {
    "especificacion": {
      "type": "object",
      "required": ["$schema"],
      "properties": { "$schema": { "const": "https://vega.github.io/schema/vega-lite/v6.json" } },
      "anyOf": [{ "required": ["layer"] }, { "required": ["vconcat"] }, { "required": ["mark"] }]
    },
    "url_explorador": { "type": "string", "pattern": "^https://vaiven\\.argentino\\.workers\\.dev/explorador/(\\?.*)?$" },
    "disposicion": {
      "type": "object",
      "required": ["tipo", "paneles"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "enum": ["unico", "doble_eje", "paneles"] },
        "paneles": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object", "required": ["unidad", "series"], "additionalProperties": false,
            "properties": { "unidad": { "type": "string" }, "series": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 4 } } }
          }
        }
      }
    },
    "series": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["numero", "id", "nombre", "unidad", "transformacion", "ultimo_dato", "advertencias", "notas", "cita"],
        "additionalProperties": false,
        "properties": {
          "numero": { "type": "integer", "minimum": 1, "maximum": 4 },
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "nombre_variante": { "type": "string" },
          "unidad": { "type": "string" },
          "transformacion": { "type": "string" },
          "paises": { "type": "array", "items": { "type": "object", "required": ["id", "nombre"] } },
          "ultimo_dato": { "type": "string" },
          "advertencias": { "type": "array", "items": { "type": "object", "required": ["id", "tipo", "descripcion"] } },
          "notas": { "type": "array", "items": { "type": "string" } },
          "cita": { "type": "string" }
        }
      }
    },
    "advertencias_combinacion": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "descripcion"], "additionalProperties": false,
        "properties": {
          "id": { "enum": ["c.frecuencia-comun", "c.sin-datos", "c.ejes-ignorado", "c.log-distinto", "c.variacion-promedio", "c.sin-equivalente"] },
          "descripcion": { "type": "string" },
          "series": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 4 } }
        }
      }
    },
    "sombreado": {
      "type": "object", "required": ["tipo", "periodos"], "additionalProperties": false,
      "properties": { "tipo": { "enum": ["catedra", "gobierno", "mandato", "ministro", "plan", "regimen_cambiario"] }, "periodos": { "type": "integer", "minimum": 1 } }
    },
    "eventos": {
      "type": "array",
      "items": {
        "type": "object", "required": ["letra", "fecha", "nombre"], "additionalProperties": false,
        "properties": { "letra": { "type": "string" }, "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "nombre": { "type": "string" } }
      }
    },
    "n_observaciones": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "version_datos": { "type": "string" }
  }
}
