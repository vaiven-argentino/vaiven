{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaiven.argentino.workers.dev/esquemas/serie-1.2.json",
  "title": "Vaivén · serie y variante exportada (export/series/<slug>/<variante>.json)",
  "description": "Contrato del JSON que consumen la web y el MCP. Si cambia, sube `esquema` y se actualizan los consumidores. La 1.2 agrega `moneda`, `insumos` (las series que necesitan las medidas real, en dólares, % del PIB y pesos actuales), `auxiliar`, `vista_inicial` y la dimensión `pais` (`dimensiones`, `entidades`, `entidades_por_defecto` y `datos` como objeto por entidad).",
  "type": "object",
  "required": [
    "esquema",
    "id",
    "serie",
    "codigo",
    "nombre",
    "variante",
    "nombre_variante",
    "es_variante_por_defecto",
    "unidad",
    "tipo",
    "agregacion",
    "frecuencia",
    "metodo",
    "empalme",
    "transformaciones",
    "tramos",
    "cobertura",
    "advertencias",
    "fuentes",
    "licencia",
    "cita",
    "version_datos",
    "desactualizada_desde",
    "datos",
    "excluidos",
    "moneda",
    "insumos",
    "auxiliar"
  ],
  "additionalProperties": false,
  "properties": {
    "esquema": {
      "const": "1.2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "serie": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "codigo": {
      "type": "string",
      "pattern": "^[A-Z]{3}-[0-9]{2}$"
    },
    "nombre": {
      "type": "string",
      "minLength": 1
    },
    "variante": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "nombre_variante": {
      "type": "string",
      "minLength": 1
    },
    "es_variante_por_defecto": {
      "type": "boolean"
    },
    "unidad": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "enum": [
        "precio",
        "flujo",
        "stock",
        "tasa",
        "cociente",
        "tasa_de_variacion"
      ]
    },
    "agregacion": {
      "enum": [
        "promedio",
        "suma",
        "fin_de_periodo"
      ]
    },
    "frecuencia": {
      "type": "string",
      "minLength": 1
    },
    "metodo": {
      "type": "string",
      "minLength": 1
    },
    "empalme": {
      "enum": [
        "encadenar_tasas",
        "yuxtaponer",
        "derivar"
      ]
    },
    "transformaciones": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "nivel",
          "var_mensual",
          "var_interanual",
          "var_dic_dic",
          "acumulada_anio",
          "base_100",
          "real",
          "en_dolares",
          "pct_pib",
          "pesos_actuales",
          "frecuencia",
          "media_movil",
          "indice_desde_tasas"
        ]
      }
    },
    "tramos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fuente",
          "desde",
          "hasta",
          "frecuencia"
        ],
        "additionalProperties": false,
        "properties": {
          "fuente": {
            "type": "string",
            "pattern": "^f\\.[a-z0-9-]+\\.[a-z0-9.-]+$"
          },
          "desde": {
            "type": "string"
          },
          "hasta": {
            "type": "string"
          },
          "rol": {
            "type": "string"
          },
          "frecuencia": {
            "enum": [
              "diaria",
              "mensual",
              "trimestral",
              "semestral",
              "anual"
            ]
          }
        }
      }
    },
    "cobertura": {
      "type": "object",
      "required": [
        "desde",
        "hasta"
      ],
      "additionalProperties": false,
      "properties": {
        "desde": {
          "type": "string"
        },
        "hasta": {
          "type": "string"
        }
      }
    },
    "advertencias": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "desde",
          "hasta",
          "tipo",
          "descripcion"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q\\."
          },
          "desde": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasta": {
            "type": [
              "string",
              "null"
            ]
          },
          "tipo": {
            "enum": [
              "cambio_de_base",
              "cobertura",
              "intervencion",
              "metodologia",
              "signo_monetario"
            ]
          },
          "descripcion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "excluidos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fecha",
          "motivo"
        ],
        "additionalProperties": false,
        "properties": {
          "fecha": {
            "type": "string",
            "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          },
          "pais": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      }
    },
    "fuentes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "organismo",
          "nombre",
          "url",
          "licencia",
          "id_api"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "organismo": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "licencia": {
            "type": "string"
          },
          "id_api": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "licencia": {
      "const": "CC-BY-4.0"
    },
    "cita": {
      "type": "string",
      "minLength": 1
    },
    "version_datos": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "desactualizada_desde": {
      "type": [
        "string",
        "null"
      ]
    },
    "datos": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Z]{3}$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
                },
                {
                  "type": "number"
                }
              ]
            }
          }
        }
      ]
    },
    "moneda": {
      "description": "En qué moneda están los valores: decide qué medidas se pueden aplicar. null en índices, tasas y porcentajes.",
      "enum": [
        "pesos_actuales",
        "moneda_de_epoca",
        "dolares",
        null
      ]
    },
    "auxiliar": {
      "type": "boolean",
      "description": "true en las series auxiliares (SPEC 2.6), que no figuran en el catálogo."
    },
    "insumos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "real": {
          "type": "object",
          "required": [
            "opciones",
            "por_defecto",
            "unidad"
          ],
          "additionalProperties": false,
          "properties": {
            "opciones": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "archivo"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "archivo": {
                    "type": "string",
                    "pattern": "^[a-z0-9./-]+\\.json$"
                  },
                  "nombre": {
                    "type": "string"
                  },
                  "frecuencia": {
                    "enum": [
                      "mensual",
                      "trimestral",
                      "anual"
                    ]
                  }
                }
              }
            },
            "por_defecto": {
              "type": "string",
              "minLength": 1
            },
            "unidad": {
              "type": "string",
              "minLength": 1,
              "description": "Unidad del resultado; «{base}» se reemplaza por la fecha base de la medida real."
            }
          }
        },
        "en_dolares": {
          "type": "object",
          "required": [
            "opciones",
            "por_defecto",
            "unidad"
          ],
          "additionalProperties": false,
          "properties": {
            "opciones": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "archivo"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "archivo": {
                    "type": "string",
                    "pattern": "^[a-z0-9./-]+\\.json$"
                  },
                  "nombre": {
                    "type": "string"
                  },
                  "frecuencia": {
                    "enum": [
                      "mensual",
                      "trimestral",
                      "anual"
                    ]
                  }
                }
              }
            },
            "por_defecto": {
              "type": "string",
              "minLength": 1
            },
            "unidad": {
              "type": "string",
              "minLength": 1,
              "description": "Unidad del resultado; «{base}» se reemplaza por la fecha base de la medida real."
            }
          }
        },
        "pct_pib": {
          "type": "object",
          "required": [
            "opciones",
            "por_defecto",
            "unidad"
          ],
          "additionalProperties": false,
          "properties": {
            "opciones": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "archivo"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "archivo": {
                    "type": "string",
                    "pattern": "^[a-z0-9./-]+\\.json$"
                  },
                  "nombre": {
                    "type": "string"
                  },
                  "frecuencia": {
                    "enum": [
                      "mensual",
                      "trimestral",
                      "anual"
                    ]
                  }
                }
              }
            },
            "por_defecto": {
              "type": "string",
              "minLength": 1
            },
            "unidad": {
              "type": "string",
              "minLength": 1,
              "description": "Unidad del resultado; «{base}» se reemplaza por la fecha base de la medida real."
            }
          }
        },
        "pesos_actuales": {
          "type": "object",
          "required": [
            "opciones",
            "por_defecto",
            "unidad"
          ],
          "additionalProperties": false,
          "properties": {
            "opciones": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "archivo"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "archivo": {
                    "type": "string",
                    "pattern": "^[a-z0-9./-]+\\.json$"
                  },
                  "nombre": {
                    "type": "string"
                  },
                  "frecuencia": {
                    "enum": [
                      "mensual",
                      "trimestral",
                      "anual"
                    ]
                  }
                }
              }
            },
            "por_defecto": {
              "type": "string",
              "minLength": 1
            },
            "unidad": {
              "type": "string",
              "minLength": 1,
              "description": "Unidad del resultado; «{base}» se reemplaza por la fecha base de la medida real."
            }
          }
        }
      }
    },
    "vista_inicial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transformacion": {
          "type": "string"
        },
        "medida": {
          "enum": [
            "real",
            "en_dolares",
            "pct_pib"
          ]
        },
        "pesos_actuales": {
          "type": "boolean"
        }
      }
    },
    "dimensiones": {
      "type": "array",
      "items": {
        "const": "pais"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "entidades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nombre"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "nombre": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entidades_por_defecto": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "dimensiones"
        ]
      },
      "then": {
        "required": [
          "entidades",
          "entidades_por_defecto"
        ],
        "properties": {
          "datos": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "datos": {
            "type": "array"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "entidades"
              ]
            },
            {
              "required": [
                "entidades_por_defecto"
              ]
            }
          ]
        }
      }
    }
  ]
}
