{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaiven.argentino.workers.dev/esquemas/eventos-1.0.json",
  "title": "Vaivén · eventos (export/eventos.json)",
  "description": "Hitos económicos e institucionales con efecto económico. `fecha` es la del hecho que nombra (anuncio, sanción, firma); `vigencia`, si es otra, la de su entrada en vigor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "esquema",
    "version_datos",
    "descripcion",
    "fuente",
    "licencia",
    "categorias",
    "eventos"
  ],
  "properties": {
    "esquema": {
      "const": "eventos-1.0"
    },
    "version_datos": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "fuente": {
      "type": "string"
    },
    "licencia": {
      "type": "string"
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          }
        }
      }
    },
    "eventos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fecha",
          "nombre",
          "nombre_corto",
          "categoria",
          "descripcion",
          "fuentes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e\\.\\d{4}-\\d{2}-\\d{2}\\.[a-z0-9-]+$"
          },
          "fecha": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "vigencia": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "nombre": {
            "type": "string"
          },
          "nombre_corto": {
            "type": "string",
            "maxLength": 24
          },
          "categoria": {
            "enum": [
              "cambiario",
              "monetario",
              "financiero",
              "fiscal",
              "deuda",
              "crisis",
              "institucional"
            ]
          },
          "descripcion": {
            "type": "string"
          },
          "notas": {
            "type": "string"
          },
          "fuentes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tipo"
              ],
              "properties": {
                "para": {
                  "enum": [
                    "desde",
                    "hasta",
                    "ambas"
                  ]
                },
                "tipo": {
                  "enum": [
                    "norma",
                    "comunicacion_bcra",
                    "oficial",
                    "secundaria",
                    "periodistica",
                    "convencional"
                  ]
                },
                "referencia": {
                  "type": "string"
                },
                "publicado": {
                  "type": "string",
                  "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "pagina": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "nota": {
                  "type": "string"
                }
              }
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
