  "advertencias": [
    {
      "id": "q.tcr-bilateral.fin-de-mes",
      "desde": "1970-01",
      "hasta": null,
      "tipo": "metodologia",
      "descripcion": "El tipo de cambio nominal es el valor de fin de mes de la serie del BCRA (CAM-01), y los IPC son promedios del mes. En los meses de devaluación (por ejemplo, diciembre de 2015 o abril de 2002), el índice refleja el tipo de cambio del último día y no el promedio del mes."
    },
    {
      "id": "q.tc.mercados-desdoblados",
      "desde": "1971-09",
      "hasta": "1989-12",
      "tipo": "metodologia",
      "descripcion": "Mercados cambiarios desdoblados. En estos años hubo, por períodos, un mercado oficial o comercial y otro financiero o libre. La serie del BCRA no sigue siempre el mismo: comparada con las series diarias, coincide con el tipo único en 1970–1971 y 1982, con el financiero en septiembre de 1981, con el oficial en junio de 1987, y queda por encima del oficial en octubre de 1988 y enero de 1989 (15,11 y 17,51 australes, contra 12,36 y 13,94)."
    },
    {
      "id": "q.ipc.2007-2015",
      "desde": "2007-01",
      "hasta": "2015-12",
      "tipo": "intervencion",
      "descripcion": "Intervención del INDEC. Desde 2016, el INDEC advierte que la información publicada para este período debe considerarse con reservas. Las mediciones provinciales y privadas de esos años registran inflaciones más altas."
    },
    {
      "id": "q.ipc.emergencia-2016",
      "desde": "2015-11",
      "hasta": "2016-04",
      "tipo": "intervencion",
      "descripcion": "Emergencia estadística (Decreto 55/2016): no hay IPC oficial entre noviembre de 2015 y abril de 2016. En la variante oficial, las tasas de esos meses salen del IPC de la Ciudad de Buenos Aires."
    },
    {
      "id": "q.ipc.cobertura",
      "desde": "2014-01",
      "hasta": "2017-01",
      "tipo": "cobertura",
      "descripcion": "Cambios de cobertura: Gran Buenos Aires hasta 2013, Nacional Urbano (IPCNu) en 2014–2015, Gran Buenos Aires otra vez entre mayo y diciembre de 2016 y Nacional desde enero de 2017."
    },
    {
      "id": "q.ipc-eeuu.octubre-2025",
      "desde": "2025-10",
      "hasta": "2025-10",
      "tipo": "cobertura",
      "descripcion": "El BLS no relevó precios en octubre de 2025 por el cierre del gobierno federal, así que ese mes no tiene dato."
    }
