    {
      "id": "q.pib.base-1986",
      "desde": "1980-01",
      "hasta": "1980-01",
      "tipo": "cambio_de_base",
      "descripcion": "Cambio de base: desde 1980, los trimestres son los de las cuentas nacionales del BCRA a precios de 1986 (el crecimiento de 1980 es el de la base 1960; el de 1981, el de la base 1986). En los años en que se superpone con la base 1970 (1981–1990), las tasas anuales difieren hasta 2,6 puntos."
    },
    {
      "id": "q.pib.base-1993",
      "desde": "1993-01",
      "hasta": "1993-01",
      "tipo": "cambio_de_base",
      "descripcion": "Cambio de base: desde 1993, los trimestres son los de las cuentas nacionales del INDEC a precios de 1993 (el crecimiento de 1993 es el de la base 1986). En 1994–1996, las tasas anuales difieren de las de la base 1986 hasta 2,2 puntos."
    },
    {
      "id": "q.pib.base-2004",
      "desde": "2004-01",
      "hasta": "2004-01",
      "tipo": "cambio_de_base",
      "descripcion": "Cambio de base: desde 2004, la serie es la de las cuentas nacionales del INDEC a precios de 2004, que da el nivel de toda la serie (el crecimiento de 2004 es el de la base 1993)."
    },
    {
      "id": "q.pib.revision-2008-2013",
